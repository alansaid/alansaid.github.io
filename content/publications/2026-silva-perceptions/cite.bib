author = {Silva, {\'I}tallo and Balby, Leandro and Said, Alan and Willemsen, Martijn C.},
title = {User Perceptions of Personalized and Generic Explanations in LLM-Driven Recommender Systems},
year = {2026},
issue_date = {September 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
